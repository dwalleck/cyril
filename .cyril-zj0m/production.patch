+            assert_eq!(tracked.status(), status);
+            assert_eq!(tracked.diff_preview().summary(), Some((1, 0)));
+            assert!(Arc::ptr_eq(&retained, tracked.diff_preview.get().unwrap()));
+            assert_eq!(tracked.diff_source().unwrap().new, "new\n");
