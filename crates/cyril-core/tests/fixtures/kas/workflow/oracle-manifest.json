    "node_start", "node_complete", "node_paused", "loop_iteration", "watch_poll", "paused", "run_complete", "steps_queued"
  ],
  "queue_rules": {
    "without_resolution": "replace_pending",
    "with_resolution": "preserve_pending_and_record_ack",
    "array_cardinalities": ["empty", "nonempty"],
    "reason_presence": ["absent", "present"]
  },
  "node_index_rules": {
    "changed_id": "move_only_changed_path",
    "shared_old_bucket": "preserve_old_peers",
    "occupied_new_bucket": "preserve_new_peers",
    "same_id_step_and_repeat": "resolve_unique_repeat",
    "same_id_two_repeats": "warn_unchanged"
  },
  "node_merge_matrix": {
    "node_start": {
      "always_replace": ["nodeId", "type"],
      "must_not_synthesize": ["status"],
      "replace_when_present_preserve_when_absent": ["agentName", "sessionId", "prompt", "iteration", "branchId"],
      "preserve_unrelated": ["artifacts", "capturedOutput", "failureReason", "completionSignal", "completionSignalSource", "nodePauseReason", "latestLoopIteration", "latestWatchPoll"]
    },
    "node_complete": {
      "always_replace": ["status"],
      "replace_when_present_preserve_when_absent": ["artifacts", "capturedOutput", "failureReason", "completionSignal", "completionSignalSource"],
      "preserve_unrelated": ["agentName", "sessionId", "prompt", "iteration", "branchId", "nodePauseReason", "latestLoopIteration", "latestWatchPoll"]
    },
    "changed_node_id": {
      "remove": "changed_path_from_old_bucket_only",
      "insert": "changed_path_into_new_bucket",
      "preserve": ["old_bucket_peers", "new_bucket_peers", "node_cardinality"]
    }
  },
  "progress_permutation_table": {
    "events": {
      "run_pause": {"runPauseReason": "operator"},
      "node_pause": {"path": ["wf", "step"], "nodePauseReason": "need-human"},
      "loop_false": {"path": ["wf", "loop"], "latestLoopIteration": {"iteration": 0, "stopConditionMet": false}},
      "loop_true": {"path": ["wf", "loop"], "latestLoopIteration": {"iteration": 1, "stopConditionMet": true}},
      "watch_first": {"path": ["wf", "watch"], "latestWatchPoll": {"outcome": "new-activity", "at": "t1"}},
      "watch_second": {"path": ["wf", "watch"], "latestWatchPoll": {"outcome": "idle-timeout", "at": "t2"}}
    },
    "orders": [
      ["run_pause", "node_pause", "loop_false", "watch_first", "loop_true", "watch_second"],
      ["watch_first", "loop_false", "node_pause", "run_pause", "watch_second", "loop_true"]
    ],
    "expected": {
      "runPauseReason": "operator",
      "nodePauseReason": "need-human",
      "latestLoopIteration": {"iteration": 1, "stopConditionMet": true},
      "latestWatchPoll": {"outcome": "idle-timeout", "at": "t2"},
      "rawHistoryEntries": 0
    }
  },
  "replay_oracle": {
    "fixture": "oracle-replay-events.jsonl",
    "methods": ["run_start", "node_start", "node_complete", "node_paused", "loop_iteration", "watch_poll", "paused", "run_complete", "steps_queued"],
    "checkpoints": ["opening", "node_opening", "event_only", "terminal", "after_retry"],
