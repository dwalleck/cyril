  "opaque_json_cases": [
    "null",
    "false",
    "true",
    "i64_min",
    "u64_max",
    "finite_fraction",
    "empty_string",
    "ascii_string",
    "unicode_string",
    "spaced_string",
    "large_string",
    "empty_array",
    "single_array",
    "multi_array",
    "duplicate_array",
    "empty_object",
    "single_object",
    "multi_object",
    "empty_key",
    "unicode_key",
    "spaced_key",
    "large_key",
    "nested_array_object",
    "duplicate_raw_key_last_wins"
