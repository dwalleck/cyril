    },
    "parallel": {
      "required": ["nodeId", "type", "branches"],
      "optional": []
    },
    "watch": {
      "required": ["nodeId", "type", "agentName"],
      "optional": []
    }
  },
  "snapshot_node_fields": {
    "required": ["nodeId", "type", "status"],
    "optional": ["children", "agentName", "modelId", "effortLevel", "maxIterations", "onMaxIterations", "stopCondition", "stopWhen", "sessionId", "artifacts", "capturedOutput", "failureReason", "iteration", "branchId", "completionSignal", "completionSignalSource", "startedAt", "endedAt", "watchCursor", "watchTerminal"]
