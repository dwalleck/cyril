  "required_shape_families": [
    "node_descriptors",
    "enum_domains",
    "opaque_json",
    "scalar_strings",
    "identifiers",
    "optional_presence",
    "collections",
    "duplicate_raw_keys",
    "numeric_and_node_paths",
    "workspace_paths",
    "typed_unknown_extras",
    "duplicate_canonical_paths",
    "completion_status_mismatches"
  ],
  "shape_boundary_outcomes": {
    "node_descriptors": "known_preserve_unknown_enum_reject",
    "enum_domains": "known_preserve_unknown_reject",
    "opaque_json": "preserve_exact_resolved_value",
    "scalar_strings": "string_preserve_wrong_type_reject",
    "identifiers": "nonempty_preserve_empty_reject",
    "optional_presence": "absent_or_valid_preserve_invalid_reject",
    "collections": "preserve_order_and_duplicates",
    "duplicate_raw_keys": "preserve_serde_json_last_value",
    "numeric_and_node_paths": "in_domain_preserve_out_of_range_reject",
    "workspace_paths": "preserve_opaque",
    "typed_unknown_extras": "ignore_extra_preserve_known_fields",
    "duplicate_canonical_paths": "converter_preserve_then_state_reject_atomically",
    "completion_status_mismatches": "converter_reject"
  },
  "repeat_controls": [
    {"parentType": "repeat", "parentId": "loop", "nodeId": "loop#2", "type": "sequence", "iteration": 2, "segment": "iter-2"},
    {"parentType": "repeat", "parentId": "loop", "nodeId": "loop#2", "type": "sequence", "segment": "iter-2"},
    {"parentType": "repeat", "parentId": "loop", "nodeId": "loop#2", "type": "sequence", "iteration": 3, "segment": "iter-3"},
    {"parentType": "repeat", "parentId": "loop", "nodeId": "loop#2", "type": "step", "iteration": 2, "segment": "iter-2"},
    {"parentType": "repeat", "parentId": "loop", "nodeId": "loop#x", "type": "sequence", "segment": "loop#x"},
    {"parentType": "repeat", "parentId": "loop", "nodeId": "loop#二", "type": "sequence", "segment": "loop#二"},
    {"parentType": "repeat", "parentId": "loop", "nodeId": "loop#02", "type": "sequence", "segment": "iter-02"},
