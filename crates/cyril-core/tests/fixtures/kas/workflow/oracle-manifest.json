  "snapshot_transition_rules": {
    "direct_missing": "seed",
    "direct_active_any_valid_status": "reconcile",
    "direct_terminal_same_status": "reconcile",
    "direct_terminal_nonterminal_or_different_terminal": "TerminalSnapshotConflict",
    "completion_missing": "warn_unchanged",
    "completion_active_valid_completion_status": "reconcile",
    "completion_terminal_exact_duplicate": "unchanged",
    "completion_terminal_non_exact": "warn_unchanged"
  },
