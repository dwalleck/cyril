+                let text = lines
+                    .iter()
+                    .flat_map(|line| &line.spans)
+                    .find_map(|span| {
+                        if span.source != run.source {
+                            return None;
+                        }
+                        let start = run.range.start.checked_sub(span.offset)?;
+                        let end = run.range.end.checked_sub(span.offset)?;
+                        span.text.get(start..end)
+                    })
