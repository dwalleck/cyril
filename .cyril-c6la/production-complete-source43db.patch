+            Notification::ToolCallStarted(
+                ToolCall::new(
+                    ToolCallId::new("review-hidden-diff"),
+                    "Review hidden Diff".into(),
+                    ToolKind::Write,
+                    ToolCallStatus::Completed,
+                    Some(serde_json::json!({"path": "review_hidden_diff.rs"})),
