{
  "name": "jlxx-policy",
  "description": "Synthetic tool-less model preflight",
  "prompt": "Reply to the supplied text. No tools.",
  "model": "claude-sonnet-4.6",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "/tmp/cyril-jlxx-r1hd42fb/workspace/evidence/authorized.txt"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "match": [
          "/tmp/cyril-jlxx-r1hd42fb/outside/private.txt"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "effect": "deny"
      },
      {
        "capability": "shell",
        "effect": "deny"
      }
    ]
  },
  "mcpServers": {},
  "resources": [],
  "includeMcpJson": false,
  "includePowers": false
}
