+            let text: String = terminal
+                .backend()
+                .buffer()
+                .content()
+                .iter()
+                .map(|cell| cell.symbol())
+                .collect();
+            assert!(text.contains(visible), "{text}");
+            assert!(!text.contains(absent), "{text}");
+        }
+        Ok(())
+    }
